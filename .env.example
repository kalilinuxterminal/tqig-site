VITE_BRIDGE_URL=http://127.0.0.1:8766
VITE_MAP_STYLE=https://tiles.openfreemap.org/styles/liberty
# Development routing only. Configure a contracted or self-hosted OSRM endpoint before a public launch.
VITE_ROUTING_BASE=https://routing.openstreetmap.de

# Local account website; deployed same-origin accounts need no override.
# Account requests select loopback locally and the current HTTPS origin on a phone.
# Leave this unset for temporary phone access.
# VITE_PORTAL_URL=https://your-account-service.example
# Server-only variables belong in the server environment, never VITE_ secrets.
# TQIG_LOCAL_PREVIEW=0
# TQIG_PUBLIC_ORIGIN=https://tqig.space
# TQIG_PORTAL_URL=https://tqig.space
# TQIG_DATA_DIR=/persistent/tqig
