FROM python:3.12-slim
WORKDIR /app
COPY backend/requirements-portal.txt /app/requirements.txt
RUN pip install --no-cache-dir -r requirements.txt && useradd --system --uid 10001 tqig && mkdir /data && chown tqig /data
COPY backend /app/backend
COPY dist /app/dist
ENV TQIG_LOCAL_PREVIEW=0 TQIG_PUBLIC_ORIGIN=https://tqig.space TQIG_PORTAL_BIND=0.0.0.0 TQIG_PORTAL_PORT=8770 TQIG_DATA_DIR=/data
USER tqig
EXPOSE 8770
CMD ["python","-m","backend.portal"]
